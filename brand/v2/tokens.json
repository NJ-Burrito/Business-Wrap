  },
  "contrastPairs": [
    ["ink", "bg", 4.5, "body text"],
    ["ink", "surface", 4.5, "body text on cards"],
    ["ink", "surface-2", 4.5, "text on raised panels"],
    ["ink-muted", "bg", 4.5, "secondary text"],
    ["ink-muted", "surface", 4.5, "secondary text on cards"],
    ["ink-faint", "surface", 4.5, "captions, placeholders"],
    ["primary", "bg", 4.5, "links and primary text"],
    ["primary", "surface", 4.5, "links on cards"],
    ["on-primary", "primary", 4.5, "primary button label"],
    ["on-accent", "accent", 4.5, "label on the highlighter"],
    ["accent-strong", "bg", 3.0, "accent as a graphic (icons, rules)"],
    ["line-strong", "surface", 3.0, "input borders"],
    ["focus", "bg", 3.0, "focus ring"],
    ["success", "surface", 4.5, "status text"],
    ["warning", "surface", 4.5, "status text"],
    ["danger", "surface", 4.5, "status text"],
    ["info", "surface", 4.5, "status text"]
  ],
  "font": {
    "display": "\"Thmanyah Serif Display\", \"Thmanyah Sans\", serif",
    "text": "\"Thmanyah Serif Text\", \"Thmanyah Sans\", serif",
    "ui": "\"Thmanyah Sans\", system-ui, sans-serif",
    "mono": "ui-monospace, Consolas, monospace"
  },
  "weight": { "regular": 400, "medium": 500, "bold": 700, "black": 900 },
  "size": {
    "$comment": "Major third (1.25) on 16 px. Arabic runs at the same size; line height is 1.6 for body because Arabic needs the room.",
    "2xs": "0.75rem",
    "xs": "0.875rem",
    "sm": "1rem",
    "md": "1.25rem",
    "lg": "1.5625rem",
    "xl": "1.953rem",
    "2xl": "2.441rem",
    "3xl": "3.052rem",
    "4xl": "3.815rem",
    "5xl": "4.768rem"
  },
  "leading": { "tight": 1.1, "snug": 1.3, "body": 1.6 },
  "tracking": { "display": "-0.01em", "ui": "0", "caps": "0.06em" },
  "space": { "0": "0", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px", "8": "64px", "9": "96px" },
  "radius": { "xs": "4px", "sm": "8px", "md": "12px", "lg": "20px", "xl": "28px", "pill": "999px" },
  "shadow": {
    "light": {
      "1": "0 1px 0 rgba(15,35,30,.06), 0 1px 3px rgba(15,35,30,.10)",
      "2": "0 2px 4px rgba(15,35,30,.06), 0 8px 20px rgba(15,35,30,.10)",
      "3": "0 6px 12px rgba(15,35,30,.08), 0 24px 48px rgba(15,35,30,.16)",
      "ring": "0 0 0 3px rgba(11,107,80,.35)"
    },
    "dark": {
      "1": "0 1px 0 rgba(0,0,0,.30), 0 1px 3px rgba(0,0,0,.40)",
      "2": "0 2px 4px rgba(0,0,0,.30), 0 8px 20px rgba(0,0,0,.45)",
      "3": "0 6px 12px rgba(0,0,0,.35), 0 24px 48px rgba(0,0,0,.55)",
      "ring": "0 0 0 3px rgba(200,240,74,.45)"
    }
  },
  "motion": {
    "duration": { "instant": "90ms", "fast": "160ms", "base": "240ms", "slow": "360ms", "page": "520ms", "story": "900ms" },
    "ease": {
      "out": "cubic-bezier(0.22, 1, 0.36, 1)",
      "in": "cubic-bezier(0.55, 0, 1, 0.45)",
      "in-out": "cubic-bezier(0.65, 0, 0.35, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "linear": "linear"
    },
    "rules": "Open slower than close (open: base or slow, close: fast). Hover-in fast, hover-out base. Stagger 40 ms per item, at most 6 items. Under prefers-reduced-motion every duration becomes 1ms and loops stop."
  }
}
