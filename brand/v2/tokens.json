      "primary-soft": "#173D31",
      "accent": "#C8F04A",
      "accent-hover": "#D6F773",
      "on-accent": "#0F231E",
      "accent-strong": "#C8F04A",
      "focus": "#C8F04A",
      "success": "#6FD48A",
      "warning": "#F2C14E",
      "danger": "#FF8A80",
      "info": "#8AB8FF"
