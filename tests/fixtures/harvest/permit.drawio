<mxfile host="drawio">
  <!-- Invented test fixture: two swimlanes, a decision, two ends. -->
  <diagram id="d1" name="Venue booking">
    <mxGraphModel>
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="lane1" value="Customer" style="swimlane;horizontal=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="800" height="160" as="geometry"/></mxCell>
        <mxCell id="lane2" value="Booking desk" style="swimlane;horizontal=0;" vertex="1" parent="1"><mxGeometry x="0" y="160" width="800" height="160" as="geometry"/></mxCell>
        <mxCell id="s" value="" style="ellipse;" vertex="1" parent="lane1"><mxGeometry x="40" y="60" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="t1" value="Choose a date &amp;amp; room" style="rounded=1;whiteSpace=wrap;" vertex="1" parent="lane1"><mxGeometry x="100" y="50" width="120" height="50" as="geometry"/></mxCell>
        <mxCell id="sys" value="Check availability" style="shape=process;" vertex="1" parent="lane2"><mxGeometry x="260" y="50" width="120" height="50" as="geometry"/></mxCell>
        <mxCell id="t2" value="&lt;b&gt;Confirm&lt;/b&gt; the booking" style="rounded=1;" vertex="1" parent="lane2"><mxGeometry x="420" y="50" width="120" height="50" as="geometry"/></mxCell>
        <mxCell id="g" value="Room free?" style="rhombus;" vertex="1" parent="lane2"><mxGeometry x="580" y="40" width="80" height="80" as="geometry"/></mxCell>
        <mxCell id="e1" value="Booked" style="ellipse;" vertex="1" parent="lane2"><mxGeometry x="700" y="20" width="60" height="40" as="geometry"/></mxCell>
        <mxCell id="e2" value="Declined" style="ellipse;" vertex="1" parent="lane2"><mxGeometry x="700" y="100" width="60" height="40" as="geometry"/></mxCell>
        <mxCell id="x1" edge="1" source="s" target="t1" parent="1"/>
        <mxCell id="x2" edge="1" source="t1" target="sys" parent="1"/>
        <mxCell id="x3" edge="1" source="sys" target="t2" parent="1"/>
        <mxCell id="x4" edge="1" source="t2" target="g" parent="1"/>
        <mxCell id="x5" value="Yes" edge="1" source="g" target="e1" parent="1"/>
        <mxCell id="x6" value="No" edge="1" source="g" target="e2" parent="1"/>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
