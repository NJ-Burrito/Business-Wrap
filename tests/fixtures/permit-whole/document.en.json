   "number": "1",
   "title": "Introduction",
   "sections": [
    {
     "number": "1.1",
     "title": "Purpose of this document",
     "blocks": [
      {
       "kind": "prose",
       "paragraphs": [
        "This document describes the requirements of a sample e-service that lets an applicant request a permit to hold a public event and follow the request until a decision is issued.",
        "The document is an anonymised example; every name and number in it is invented."
       ]
      }
     ]
    },
    {
     "number": "1.2",
     "title": "Scope of the service",
     "blocks": [
      {
       "kind": "prose",
       "paragraphs": [
        "The service covers the following:",
        "• Filling in the request form and attaching the required documents.",
        "• Review of the request by the responsible officer.",
        "• Issuing the decision and notifying the applicant."
       ]
      }
     ]
    }
   ]
  },
