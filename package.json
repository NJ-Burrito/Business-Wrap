{
  "name": "business-wrap",
  "version": "0.15.0",
  "description": "Bilingual (Arabic RTL / English LTR) requirements documents from evidence: an interactive HTML editor that is the print layout, PDF + DOCX export, design packs and security gates.",
  "license": "MIT",
  "mcpName": "io.github.NJ-Burrito/business-wrap",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NJ-Burrito/Business-Wrap.git"
  },
  "homepage": "https://github.com/NJ-Burrito/Business-Wrap",
  "keywords": [
    "requirements",
    "srs",
    "arabic",
    "bilingual",
    "rtl",
    "pdf",
    "docx",
    "html-editor",
    "design-tokens",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "claude-code"
  ],
  "type": "module",
  "bin": {
    "business-wrap-mcp": "mcp/cli.mjs",
    "business-wrap": "update/cli.mjs"
  },
  "files": [
    "engine",
    "!**/__pycache__",
    "editor",
    "mcp/cli.mjs",
    "mcp/server.mjs",
    "mcp/startup.mjs",
    "mcp/editor-tools.mjs",
    "mcp/vendor/sdk.mjs",
    "mcp/README.md",
    "mcp/README.ar.md",
    "mcp/server.json",
    "fonts/manifest.json",
    "fonts/nj-fonts",
    "templates",
    "design/ours/theme.json",
    "palette",
    "typography",
    "samples/event-permit/*.json",
    "bible/contracts",
    "SKILL.md",
    "README.md",
    "README.ar.md",
    "LICENSE",
    "assets/editor",
    "samples/blank/*.json",
    "brand/v3/tokens-v3.css",
    "brand/v3/logo",
    "brand/v3/icons/*.svg",
    "brand/v3/icons/icons.css",
    "brand/v3/file-icons/*.png",
    "brand/v3/file-icons/*.jpg",
    "brand/v3/file-icons/*.svg",
    "brand/v3/file-icons/folder.ico",
    "NOTICE.md",
    "update",
    "CHANGELOG.md",
    "AGENTS.md",
    "hooks",
    "commands",
    ".claude-plugin"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node engine/build-skill-html.mjs --check && node tests/run.mjs",
    "test:serial": "node engine/build-skill-html.mjs --check && node tests/run.mjs --serial",
    "test:changed": "node tests/run.mjs --changed",
    "test:only": "node tests/run.mjs",
    "fixture:history": "node tools/fixtures/history.mjs make",
    "gate:history": "node tools/release/history-gate.mjs",
    "test:mcp": "node mcp/test/server.test.mjs",
    "mcp": "node mcp/cli.mjs",
    "sample": "node engine/build-editor.mjs samples/event-permit --out out/sample/event-permit.editor.html --set sample",
    "serve": "node engine/serve.mjs",
    "skill-html": "node engine/build-skill-html.mjs",
    "update:check": "node update/cli.mjs --check",
    "version:sync": "node update/version-sync.mjs",
    "harvest:model": "node engine/harvest/cli.mjs model",
    "harvest:crawl": "node engine/harvest/cli.mjs crawl",
    "harvest:merge": "node engine/harvest/cli.mjs merge",
    "diagram:mermaid": "node engine/diagram-cli.mjs",
    "learn": "node engine/learning/cli.mjs",
    "test:learning": "node tests/learning.test.mjs",
    "cli": "node engine/cli.mjs",
    "host": "node engine/cli.mjs open",
    "host:close": "node engine/cli.mjs close",
    "audit": "node tests/audit.probe.mjs",
    "test:docx-fidelity": "uv run --no-project --with pywin32 --with pymupdf python tests/docx_fidelity.py",
    "vendor:mcp": "esbuild mcp/vendor/entry.mjs --bundle --platform=node --format=esm --minify --legal-comments=eof --outfile=mcp/vendor/sdk.mjs \"--banner:js=/* Bundled by npm run vendor:mcp from @modelcontextprotocol/sdk, zod, ajv, ajv-formats, fast-deep-equal, json-schema-traverse (MIT), zod-to-json-schema (ISC), fast-uri (BSD-3-Clause). Do not edit. */ import{createRequire as __bwCR}from'node:module';const require=__bwCR(import.meta.url);\"",
    "vendor:spell": "node tools/vendor-spell.mjs"
  },
  "dependencies": {
    "playwright-core": "^1.62.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "axe-core": "^4.14.0",
    "dictionary-en": "4.0.0",
    "esbuild": "^0.25.10",
    "hunspell-asm": "4.0.2",
    "lucide-static": "^1.62.0",
    "zod": "^4.6.7"
  }
}
