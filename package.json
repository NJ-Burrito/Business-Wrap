{
  "name": "business-wrap",
  "version": "0.12.0",
  "description": "Bilingual (Arabic RTL / English LTR) requirements documents from evidence: an interactive HTML editor that is the print layout, PDF + DOCX export, design packs and security gates.",
  "license": "MIT",
  "mcpName": "io.github.NJ-Burrito/business-wrap",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NJ-Burrito/Business-Wrap.git"
  },
  "homepage": "https://github.com/NJ-Burrito/Business-Wrap",
  "keywords": [
    "requirements",
    "srs",
    "arabic",
    "bilingual",
    "rtl",
    "pdf",
    "docx",
    "html-editor",
    "design-tokens",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "claude-code"
  ],
  "type": "module",
  "bin": {
    "business-wrap-mcp": "mcp/cli.mjs",
    "business-wrap": "update/cli.mjs"
  },
  "files": [
    "engine",
    "!**/__pycache__",
    "editor",
    "mcp/cli.mjs",
    "mcp/server.mjs",
    "mcp/README.md",
    "mcp/README.ar.md",
    "mcp/server.json",
    "fonts/manifest.json",
    "fonts/nj-fonts",
    "templates",
    "design/ours/theme.json",
    "palette",
    "typography",
    "samples/event-permit/*.json",
    "bible/contracts",
    "SKILL.md",
    "README.md",
    "README.ar.md",
    "LICENSE",
    "assets/editor",
    "samples/blank/*.json",
    "brand/v3/tokens-v3.css",
    "brand/v3/logo",
    "brand/v3/icons/*.svg",
    "brand/v3/icons/icons.css",
    "NOTICE.md",
    "update",
    "CHANGELOG.md",
    "AGENTS.md",
    "hooks"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node engine/build-skill-html.mjs --check && node tests/editor.test.mjs && node tests/a11y.test.mjs && node mcp/test/server.test.mjs && node tests/skill-html.test.mjs && node tests/update.test.mjs && node tests/harvest.test.mjs && node tests/editable.test.mjs && node tests/field.test.mjs && node tests/diagram.test.mjs && node tests/design.test.mjs && node tests/ux.test.mjs && node tests/updater.test.mjs && node tests/settings.test.mjs && node tests/learning.test.mjs && node tests/print.test.mjs && node tests/srs.test.mjs",
    "test:mcp": "node mcp/test/server.test.mjs",
    "mcp": "node mcp/cli.mjs",
    "sample": "node engine/build-editor.mjs samples/event-permit --out out/sample/event-permit.editor.html --set sample",
    "serve": "node engine/serve.mjs",
    "skill-html": "node engine/build-skill-html.mjs",
    "update:check": "node update/cli.mjs --check",
    "version:sync": "node update/version-sync.mjs",
    "harvest:model": "node engine/harvest/cli.mjs model",
    "harvest:crawl": "node engine/harvest/cli.mjs crawl",
    "harvest:merge": "node engine/harvest/cli.mjs merge",
    "diagram:mermaid": "node engine/diagram-cli.mjs",
    "learn": "node engine/learning/cli.mjs",
    "test:learning": "node tests/learning.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright-core": "^1.62.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "lucide-static": "^1.62.0"
  }
}
