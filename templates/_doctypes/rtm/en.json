          "number": "1.1",
          "title": "Columns and coverage states",
          "blocks": [
            {
              "kind": "prose",
              "paragraphs": [
                "Tie each row to one requirement; never merge two requirements into one row. The states below say how far a requirement is covered."
              ]
            },
            {
              "kind": "table",
              "columns": [
                "State",
                "Meaning"
              ],
              "rows": [
                [
                  "Covered",
                  "Has a design, a test case and a passing result"
                ],
                [
                  "Partial",
                  "Has some links but not all"
                ],
                [
                  "Gap",
                  "No test case or no design yet"
                ],
                [
                  "Out of scope",
                  "Dropped by a change request"
                ]
