      "sections": [
        {
          "title": "How to use this sheet",
          "blocks": [
            {
              "kind": "prose",
              "paragraphs": [
                "Explain the status and severity values used in the sheet. Write each case so that another tester can run it without asking."
              ]
            },
            {
              "kind": "table",
              "columns": [
                "Value",
                "Meaning"
              ],
              "rows": [
                [
                  "Passed",
                  "The actual result matches the expected one"
                ],
                [
                  "Failed",
                  "The actual result differs from the expected one"
                ],
                [
                  "Blocked",
                  "Cannot run for a reason outside the case"
                ],
                [
                  "Not run",
                  "The case has not been run yet"
                ]
              ]
            },
            {
              "kind": "table",
              "columns": [
                "Severity",
                "Meaning"
              ],
              "rows": [
                [
                  "Critical",
                  "System down or data lost"
                ],
                [
                  "High",
                  "A core function does not work"
                ],
                [
                  "Medium",
                  "A fault with a workaround"
                ],
                [
                  "Low",
                  "A cosmetic fault"
                ]
              ]
            }
          ]
        }
      ]
