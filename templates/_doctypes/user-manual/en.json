            }
          ]
        },
        {
          "number": "1.2",
          "title": "Conventions",
          "blocks": [
            {
              "kind": "prose",
              "paragraphs": [
                "Button and field names appear in « » exactly as the screen shows them. The numbered circles on screenshots match the numbers of the steps. Four kinds of callout appear in the guide.",
                "Note: adds a condition or an explanation.",
                "Tip: shows a quicker way.",
                "Important: something to do before you continue.",
                "Warning: an action that cannot be undone."
              ]
            }
          ]
        },
