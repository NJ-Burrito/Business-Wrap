      "number": "1",
      "title": "Introduction",
      "sections": [
        {
          "number": "1.1",
          "title": "Purpose of the document",
          "blocks": [
            {
              "kind": "prose",
              "paragraphs": [
                "State why this document exists and who reads it: the development team, the testers and the service owner. Example: \"This document sets out what the [service name] service must do, so that it can be built, tested and accepted.\""
              ]
            }
          ]
        },
        {
          "number": "1.2",
          "title": "Scope",
          "blocks": [
            {
              "kind": "prose",
              "paragraphs": [
                "State what the service covers and what it leaves out. Name each boundary: the users, the channels and the systems it connects to."
              ]
            }
          ]
        },
        {
          "number": "1.3",
          "title": "Definitions and abbreviations",
          "blocks": [
            {
              "kind": "table",
              "columns": [
                "Term",
                "Definition"
              ],
              "rows": [
                [
                  "FR",
                  "Functional requirement: something the service must do."
                ],
                [
                  "NFR",
                  "Non-functional requirement: how well the service must do it."
                ],
                [
                  "BR",
                  "Business rule: a rule of the organisation that the service enforces."
                ],
                [
                  "…",
                  "…"
                ]
