        },
        {
          "number": "4.2",
          "title": "The trainer's role",
          "blocks": [
            {
              "kind": "prose",
              "paragraphs": [
                "The trainer facilitates rather than lectures: sets the task, keeps time, asks questions and collects feedback. For a group above […], use two trainers."
              ]
            }
          ]
        }
      ]
    },
