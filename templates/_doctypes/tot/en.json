                  "10 minutes"
                ],
                [
                  "Exercise",
                  "To practise the concept.",
                  "20 minutes"
                ],
                [
                  "Discussion",
                  "To link it to real work.",
                  "15 minutes"
                ]
              ],
              "colWidths": [
                24,
                50,
                26
