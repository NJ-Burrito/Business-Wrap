      "sections": [
        {
          "number": "4.1",
          "title": "Method",
          "blocks": [
            {
              "kind": "prose",
              "paragraphs": [
                "Each topic follows one cycle: a short input, an exercise, then a discussion."
              ]
            },
            {
              "kind": "table",
              "columns": [
                "Method",
                "When to use it",
                "Suggested time"
              ],
              "rows": [
                [
