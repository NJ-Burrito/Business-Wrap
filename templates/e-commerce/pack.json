   "sections": [
    {
     "title": {
      "ar": "الغرض من الوثيقة",
      "en": "Purpose"
     },
     "gen": "prose",
     "paragraphs": {
      "ar": [
       "تحدد هذه الوثيقة متطلبات «{name}» لدى {entity}: ما يراه العميل من الكتالوج حتى الدفع، وما يجري على الطلب بعد ذلك حتى التسليم أو الإرجاع."
      ],
      "en": [
       "This document states the requirements of «{name}» at {entity}: what the customer sees from the catalogue to checkout, and what happens to the order afterwards until delivery or return."
      ]
     }
    },
    {
     "title": {
      "ar": "النطاق",
      "en": "Scope"
     },
     "gen": "prose",
     "paragraphs": {
      "ar": [
       "يشمل النطاق قنوات البيع: {channels}، ومراحل تجهيز الطلب وشحنه وإرجاعه، والتكامل مع مزودي الدفع والشحن."
      ],
      "en": [
       "The scope covers the sales channels ({channels}), the order's preparation, shipping and return stages, and the integrations with payment and shipping providers."
      ]
     }
    }
   ]
